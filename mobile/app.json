{
  "expo": {
    "name": "Bản đồ đo nhiệt độ, chỉ số thực vật và chỉ số khô hạn TP.HCM",
    "slug": "mobilegis-hcm",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.edu.mobilegis.hcm",
      "versionCode": 4,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MobileGIS dùng vị trí của bạn để cho biết bạn đang ở xã/phường nào. Tọa độ không được lưu."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": false
          }
        }
      ]
    ],
    "scheme": "mobilegis",
    "experiments": {},
    "splash": {
      "backgroundColor": "#f3f6f8",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    }
  }
}
